    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.2",
    "@types/node": "^24.10.1",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@getpaseo/plugin": ">=0.15.3",
    "react": ">=19",
    "react-native": ">=0.81"
  }
