{
  "name": "paseo-markdown",
  "version": "0.1.1",
  "description": "Write Markdown in Paseo with a live preview rendered by Paseo's own Markdown engine",
  "keywords": [
    "codemirror",
    "editor",
    "markdown",
    "paseo",
    "paseo-plugin",
    "preview"
  ],
  "homepage": "https://github.com/Ericwong5021/paseo-live-markdown#readme",
  "bugs": {
    "url": "https://github.com/Ericwong5021/paseo-live-markdown/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ericwong5021/paseo-live-markdown.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.zh-CN.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "tsconfig.json",
    "assets/"
  ],
